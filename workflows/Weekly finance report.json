    {
      "parameters": {
        "jsCode": "const transactions = $input.all();\n\nlet totalSpend = 0;\nlet totalNeeds = 0;\nlet totalWants = 0;\n\nconst categoryTotals = {};\n\nfor (const item of transactions) {\n\n  const t = item.json;\n\n  const amount = Number(t.amount);\n\n  totalSpend += amount;\n\n  if (t.need_want === \"Need\") {\n    totalNeeds += amount;\n  }\n\n  if (t.need_want === \"Want\") {\n    totalWants += amount;\n  }\n\n  // Category aggregation\n  if (!categoryTotals[t.category]) {\n    categoryTotals[t.category] = 0;\n  }\n\n  categoryTotals[t.category] += amount;\n}\n\n// Convert categories into sorted text\nconst sortedCategories = Object.entries(categoryTotals)\n  .sort((a, b) => b[1] - a[1]);\n\nlet categoryText = \"\";\n\nfor (const [category, amount] of sortedCategories) {\n  categoryText += `- ${category}: ₹${amount}\\n`;\n}\n\nconst report = `\nWeekly Spend Report\n\nTotal Spend: ₹${totalSpend}\n\nNeeds: ₹${totalNeeds}\nWants: ₹${totalWants}\n\nCategory Breakdown:\n${categoryText}\n`;\n\nreturn [\n  {\n    json: {\n      report\n    }\n  }\n];"
      },
